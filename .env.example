# Console API key (console.anthropic.com) — NOT your Pro subscription login.
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI API key (platform.openai.com)
OPENAI_API_KEY=sk-...

# Groq API key (console.groq.com) 
GROQ_API_KEY=gsk_...

# PROVIDER=openai/anthropic/groq
PROVIDER=groq

# Must match the PROVIDER above. Falls back to a per-provider default if unset.
# Note: multi-step tool loops are less reliable on the open-weights models below.
# MODEL=claude-haiku-4-5
# MODEL=claude-fable-5
# MODEL=claude-haiku-4-5
# MODEL=llama-3.3-70b-versatile
# MODEL=qwen/qwen3.6-27b
MODEL=openai/gpt-oss-120b

# Server
PORT=3939

# CLI target (defaults to the server above)
API_URL=http://localhost:3939

# MCP settings
# MCP turns on automatically when an mcp.json exists. MCP_ENABLED=1 forces it
# on (using the MCP_COMMAND fallback below); MCP_ENABLED=0 forces it off.
MCP_ENABLED=1

# JSON config declaring the stdio servers, in the same `mcpServers` shape as
# Claude Desktop / Cursor. Relative paths resolve from the cwd. See
# mcp.example.json — `cp mcp.example.json mcp.json` to get started.
MCP_CONFIG=./mcp.json

# Single-server fallback, used only when there is no usable mcp.json.
MCP_COMMAND=<binary_name> # binary name of the MCP client (e.g., loccibox)
MCP_ARGS=<command_args> # <mcp start>

